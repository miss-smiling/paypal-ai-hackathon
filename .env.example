# Copy to .env and fill in. Leave secrets blank to run in demo mode.
# Team-shared keys are NOT stored in this repo. Get them from the team lead.

# --- Database ---
# Local default is a SQLite file. For Neon PostgreSQL paste the connection string:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=sqlite:///./smartcart.db

# --- CORS (comma-separated frontend origins) ---
ALLOWED_ORIGINS=http://localhost:3000

# --- LLM (optional). Gemini first, then OpenAI, otherwise rule-based parsing. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- PayPal REST API (Sandbox). Blank = mock checkout. ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- Live product feed (optional). SerpApi Google Shopping India. Blank = local catalog. ---
SERPAPI_API_KEY=
SERP_CACHE_TTL=900

# --- Pricing ---
CURRENCY=INR
FREE_SHIPPING_THRESHOLD=35
FLAT_SHIPPING_FEE=5.99
